# Copy to .env.local and fill in from Supabase: Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Leave the Supabase values empty to run in demo mode with mock data.
# Only this one account can sign in there (defaults: admin@matchmaking.test / letmein).
VITE_MOCK_ADMIN_EMAIL=
VITE_MOCK_ADMIN_PASSWORD=
